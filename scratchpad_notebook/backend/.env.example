# Server
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development

# Optional comma-separated allowed CORS origins for production
# CORS_ORIGINS=https://your-nilo-domain.example.com

# LLM Provider (OpenAI-compatible, e.g. Groq / OpenAI)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_llm_api_key_here

# Vision LLM (for handwriting recognition)
VISION_LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
VISION_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VISION_LLM_MODEL=gemini-3.5-flash-lite
VISION_LLM_API_KEY=your_vision_llm_api_key_here

# Recognition thresholds
RECOGNITION_CONFIDENCE_THRESHOLD=0.75
MAX_CLARIFICATION_ATTEMPTS=2

# Solver
MAX_SOLVER_RETRIES=2
SYMPY_VERBOSE=false
