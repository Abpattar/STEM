      "source": "typed"
    },
    "expected_step": {
      "step_number": 1,
      "operation": "subtract_both_sides",
      "equation_ast": {
        "type": "eq",
        "left": {"type": "add", "args": [{"type": "symbol", "name": "x"}, {"type": "number", "value": 3}]},
        "right": {"type": "number", "value": 7}
      },
      "result_ast": {
        "type": "eq",
