# =====================================================================
# NILO Science Kingdom AI Backend (Senku AI) — Environment Template
# Copy to science_ai_backend/.env on the server (NEVER commit .env)
# =====================================================================

# OpenAI-compatible provider key (Groq, xAI, OpenAI, OpenRouter, etc.)
SCIENCE_AI_API_KEY=

# OpenAI-compatible chat completions endpoint
SCIENCE_AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Model identifier supported by the configured endpoint
SCIENCE_AI_MODEL=openai/gpt-oss-20b

# Optional comma-separated allowed CORS origins for production
# SCIENCE_AI_CORS_ORIGINS=https://your-nilo-domain.example.com

