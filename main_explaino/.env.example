# =====================================================================
# NILO Master Frontend (main_explaino) — Environment Template
# Copy to main_explaino/.env if you need custom local proxy/API paths.
#
# SECURITY WARNING:
#   NEVER put private API keys (Groq, Gemini, NVIDIA, OpenRouter,
#   Sarvam, MongoDB, etc.) in VITE_* variables. Everything prefixed
#   with VITE_ is compiled into the public browser JavaScript bundle.
# =====================================================================

# Browser-facing relative API prefixes (recommended for both dev & production reverse proxies)
VITE_MATH_API_BASE=/api/math
VITE_SCIENCE_API_BASE=/api/science
VITE_TUTOR_API_BASE=/api/tutor

# Vite dev-server proxy targets (server-side during `vite dev` only, never exposed to browser)
MATH_API_TARGET=http://127.0.0.1:8001
SCIENCE_AI_TARGET=http://127.0.0.1:8002
TUTOR_API_TARGET=http://localhost:3000
