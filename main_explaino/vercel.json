{
  "rewrites": [
    {
      "source": "/api/tutor/:path*",
      "destination": "https://nilo-exo-backend.vercel.app/api/:path*"
    },
    {
      "source": "/api/math/:path*",
      "destination": "https://nilo-math-backend.vercel.app/api/:path*"
    },
    {
      "source": "/api/science/:path*",
      "destination": "https://nilo-science-ai.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
